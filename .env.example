# Valores locais de exemplo para rodar a aplicacao fora do Docker Compose
# (a infraestrutura continua vindo do compose: `make infra`).
# Dentro do compose, os hosts sao postgres, localstack e keycloak.

APP_INSTANCE_ID=local-1
APP_ROLES=api,consumer,outbox
# 8080 no host pertence ao Keycloak; 8081-8083 as instancias do compose.
HTTP_ADDR=:8090
SHUTDOWN_TIMEOUT=20s

LOG_LEVEL=info
LOG_FORMAT=json

DATABASE_URL=postgres://wager:wager@localhost:5433/wager?sslmode=disable
DATABASE_MAX_CONNS=10

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30

# Issuer gravado nos tokens (fixado por KC_HOSTNAME no compose). Fora do
# compose o discovery usa o mesmo endereco; dentro, OIDC_DISCOVERY_URL aponta
# para http://keycloak:8080/realms/wager.
OIDC_ISSUER_URL=http://localhost:8080/realms/wager
OIDC_DISCOVERY_URL=http://localhost:8080/realms/wager
OIDC_AUDIENCE=wager-api
OIDC_INTERNAL_ROLE=internal-service
OIDC_PROVIDER_ROLE=provider
OIDC_PROVIDER_CLAIM=provider_id

OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_MAX_ATTEMPTS=10

REFERENCE_POLL_INTERVAL=1s
REFERENCE_MAX_ATTEMPTS=8
REFERENCE_BASE_BACKOFF=2s
REFERENCE_TTL=5m
